DEBUG=True
SECRET_KEY=your-secret-key-here
BACKEND_SENTRY_DSN=

# Hosts/origins for local tunnel/proxy setups (comma-separated)
# Example:
# ALLOWED_HOSTS=localhost,127.0.0.1,9647-46-205-207-234.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Example:
# CSRF_TRUSTED_ORIGINS=https://9647-46-205-207-234.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# GitHub App credentials
# Create a GitHub App at https://github.com/settings/apps
# In your GitHub App settings, set Setup URL to:
# https://<your-app-host>/api/github/setup
GITHUB_APP_ID=
# Preferred: path to PEM private key file (avoids multiline .env parsing issues)
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative: PEM private key as a single-line env var with escaped newlines (\n)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=vibeaudit

# Set to True to allow unauthenticated users to start audits (local dev only)
ALLOW_UNAUTHENTICATED_AUDIT=False
