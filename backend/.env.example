DEBUG=True
SECRET_KEY=your-secret-key-here
BACKEND_SENTRY_DSN=

# Hosts/origins for local tunnel/proxy setups (comma-separated)
# Example:
# ALLOWED_HOSTS=localhost,127.0.0.1,9647-46-205-207-234.ngrok-free.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Example:
# CSRF_TRUSTED_ORIGINS=https://9647-46-205-207-234.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# GitHub App credentials
# Create a GitHub App at https://github.com/settings/apps
# In your GitHub App settings, set Setup URL to:
# https://<your-app-host>/api/github/setup
GITHUB_APP_ID=
# Preferred: path to PEM private key file (avoids multiline .env parsing issues)
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative: PEM private key as a single-line env var with escaped newlines (\n)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=vibeaudit

# Set to True to allow unauthenticated users to start audits (local dev only)
ALLOW_UNAUTHENTICATED_AUDIT=False

# Redis (leave empty to run Celery tasks synchronously in local dev)
REDIS_URL=

# Repo clone storage (defaults to backend/repos/ if unset)
REPOS_DIR=

# AI / LLM
ANTHROPIC_API_KEY=
AVAILABLE_AI_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-7

# Celery task time limits (seconds)
AUDIT_TASK_SOFT_TIME_LIMIT_SECONDS=600
AUDIT_TASK_TIME_LIMIT_SECONDS=660

# Cross-origin funnel (ulam.io). Comma-separated. Leave empty for standalone dev.
CORS_ALLOWED_ORIGINS=
AUDIT_ALLOWED_RETURN_ORIGINS=
AUDIT_ENFORCE_CSRF=False
# Cookie security; default follows DEBUG. Override only if needed.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
